<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Live Typography Playground Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp"
            app:cardCornerRadius="14dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_text_fields"
                        android:contentDescription="Playground"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Live Typography Playground"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface" />
                </LinearLayout>

                <!-- Interactive Test Input: Constrained container height with vertical scroll so increasing font size scales within bounds -->
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_preview_test"
                    android:layout_width="match_parent"
                    android:layout_height="140dp"
                    android:hint="Type custom text to test font..."
                    android:text="The Quick Brown Fox Jumps Over The Lazy Dog 1234567890"
                    android:background="@drawable/background_white"
                    android:padding="12dp"
                    android:textColor="#191C1D"
                    android:textSize="22sp"
                    android:maxLines="6"
                    android:scrollbars="vertical"
                    android:fadeScrollbars="false"
                    android:nestedScrollingEnabled="true"
                    android:gravity="top|start"
                    android:layout_marginBottom="12dp" />

                <!-- Quick Pangram Chips -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quick Sample Pangrams:"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginBottom="6dp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginBottom="12dp">

                    <com.google.android.material.chip.ChipGroup
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleLine="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_pangram_fox"
                            style="@style/Widget.Material3.Chip.Assist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Quick Brown Fox" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_pangram_box"
                            style="@style/Widget.Material3.Chip.Assist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pack My Box" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_pangram_numbers"
                            style="@style/Widget.Material3.Chip.Assist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0-9 Numbers" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chip_pangram_symbols"
                            style="@style/Widget.Material3.Chip.Assist"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="!@#$%^&amp;* Symbols" />
                    </com.google.android.material.chip.ChipGroup>
                </HorizontalScrollView>

                <!-- Font Size Slider -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_format_size"
                        android:contentDescription="Font Size"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:layout_width="95dp"
                        android:layout_height="wrap_content"
                        android:text="Size:"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/slider_preview_size"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:valueFrom="12"
                        android:valueTo="72"
                        android:stepSize="2"
                        android:value="22" />

                    <TextView
                        android:id="@+id/text_preview_size_val"
                        android:layout_width="45dp"
                        android:layout_height="wrap_content"
                        android:text="22sp"
                        android:gravity="end"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="?attr/colorOnSurface" />
                </LinearLayout>

                <!-- Letter Spacing Slider -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_tune"
                        android:contentDescription="Letter Spacing"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:layout_width="95dp"
                        android:layout_height="wrap_content"
                        android:text="Spacing:"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/slider_letter_spacing"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:valueFrom="-0.05"
                        android:valueTo="0.30"
                        android:stepSize="0.01"
                        android:value="0.0" />

                    <TextView
                        android:id="@+id/text_letter_spacing_val"
                        android:layout_width="45dp"
                        android:layout_height="wrap_content"
                        android:text="0.00"
                        android:gravity="end"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="?attr/colorOnSurface" />
                </LinearLayout>

                <!-- Thickness / Weight Slider -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_brush"
                        android:contentDescription="Font Thickness"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:layout_width="95dp"
                        android:layout_height="wrap_content"
                        android:text="Thickness:"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/slider_preview_weight"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:valueFrom="100"
                        android:valueTo="900"
                        android:stepSize="100"
                        android:value="400" />

                    <TextView
                        android:id="@+id/text_preview_weight_val"
                        android:layout_width="55dp"
                        android:layout_height="wrap_content"
                        android:text="Regular"
                        android:gravity="end"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="?attr/colorOnSurface" />
                </LinearLayout>

                <!-- Preview Text Color Selection -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Font Color:"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:layout_marginEnd="10dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/preview_color_black"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        app:cornerRadius="16dp"
                        android:backgroundTint="#191C1D"
                        android:layout_marginEnd="6dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/preview_color_turquoise"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        app:cornerRadius="16dp"
                        android:backgroundTint="#00C4B4"
                        android:layout_marginEnd="6dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/preview_color_blue"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        app:cornerRadius="16dp"
                        android:backgroundTint="#1976D2"
                        android:layout_marginEnd="6dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/preview_color_red"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        app:cornerRadius="16dp"
                        android:backgroundTint="#D32F2F"
                        android:layout_marginEnd="6dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/preview_color_amber"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        app:cornerRadius="16dp"
                        android:backgroundTint="#FF8F00"
                        android:layout_marginEnd="6dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/preview_color_white"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        app:cornerRadius="16dp"
                        android:backgroundTint="#FFFFFF"
                        app:strokeColor="#74777F"
                        app:strokeWidth="1dp" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Character Map Inspector Grid -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1dp"
            app:cardCornerRadius="14dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_grid_view"
                        android:contentDescription="Character Map"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Character Map Inspector (94 Glyphs)"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="?attr/colorOnSurface" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_glyph_inspector"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Export Options Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1.5dp"
            app:cardCornerRadius="14dp"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Export Font"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:layout_marginBottom="10dp" />

                <!-- Format Selection Toggle -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="14dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:text="Primary Format:"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorOnSurface" />

                    <com.google.android.material.button.MaterialButtonToggleGroup
                        android:id="@+id/toggle_format"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleSelection="true"
                        app:checkedButton="@id/button_format_ttf">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/button_format_ttf"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TTF" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/button_format_otf"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="OTF" />
                    </com.google.android.material.button.MaterialButtonToggleGroup>
                </LinearLayout>

                <!-- Export Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_export_font"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="Export"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/text_font_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ready. 100% offline local compilation."
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:layout_marginTop="12dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
