<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?attr/colorSurface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Character Selector Bar (Real Interactive Horizontal Grid) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/text_draw_current_letter"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Drawing Character: 'A'"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_toggle_guidelines"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rulers ON"
                app:icon="@drawable/ic_tune" />
        </LinearLayout>

        <!-- Category Filter Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="6dp">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_draw_categories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:checkedButton="@id/chip_draw_cat_az_upper">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_draw_cat_az_upper"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="A - Z (Letters)" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_draw_cat_az_lower"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="a - z (Lower)" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_draw_cat_numbers"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 - 9 (Numbers)" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_draw_cat_symbols"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="!@#$ (Symbols)" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- Horizontal Character Chips Grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_draw_characters"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp" />

        <!-- Drawing Tool Palette (Pen vs Eraser, Brush Width, Colors) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggle_draw_tool"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:checkedButton="@id/tool_pen">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tool_pen"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pen"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tool_line"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Line"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tool_bezier"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bezier"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tool_eraser"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Eraser"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <Space
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content" />

            <!-- Color Chips -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/color_black"
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:cornerRadius="18dp"
                android:backgroundTint="#000000"
                android:layout_marginEnd="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/color_blue"
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:cornerRadius="18dp"
                android:backgroundTint="#1976D2"
                android:layout_marginEnd="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/color_red"
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:cornerRadius="18dp"
                android:backgroundTint="#D32F2F" />
        </LinearLayout>

        <!-- Brush Width Slider Widget -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_brush"
                android:contentDescription="Brush Size"
                android:layout_marginEnd="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Size:"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.slider.Slider
                android:id="@+id/slider_brush_width"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:valueFrom="8"
                android:valueTo="64"
                android:stepSize="4"
                android:value="28" />

            <TextView
                android:id="@+id/text_brush_width_val"
                android:layout_width="35dp"
                android:layout_height="wrap_content"
                android:text="28"
                android:gravity="end"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="?attr/colorOnSurface" />
        </LinearLayout>

        <!-- Dedicated Canvas Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutline"
            app:strokeWidth="1.5dp"
            app:cardCornerRadius="14dp"
            android:layout_marginBottom="12dp">

            <jp.naklab.assu.android.android_myownfont.FontCanvas
                android:id="@+id/main_font_canvas"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:background="@color/white" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Canvas Action Buttons (Undo, Clear, Save Glyph) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_undo"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Undo"
                app:icon="@drawable/ic_undo"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_clear"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Clear"
                app:icon="@drawable/ic_clear"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_save_stroke"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_weight="1.3"
                android:layout_height="wrap_content"
                android:text="Confirm"
                app:icon="@drawable/ic_check_circle"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />
        </LinearLayout>

        <!-- Status display -->
        <TextView
            android:id="@+id/text_draw_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginBottom="16dp"
            android:visibility="gone" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
